{
  "name": "@vanibot/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "test": "vitest run",
    "db:setup": "tsx --env-file-if-exists=../../.env src/setup-db.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "html-to-text": "^10.0.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "pgvector": "^0.3.0",
    "twilio": "^6.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
