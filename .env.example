# ---- Required ----
DATABASE_URL=postgres://vanibot:vanibot@localhost:5432/vanibot
# Long random string used to sign dashboard login tokens
JWT_SECRET=change-me-to-a-long-random-string
# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---- Optional ----
PORT=4000
# Public URL of the API (used in the embed snippet and Twilio callbacks)
PUBLIC_URL=http://localhost:4000
# Dashboard URL (CORS + Stripe redirects)
DASHBOARD_URL=http://localhost:5173
# Claude model and effort for bot replies
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# Server-side refusal fallback (set to "off" to disable)
LLM_FALLBACKS=default

# Embeddings for semantic search. Without a key, search falls back to keyword (full-text) only.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# Stripe billing. Without these, plans can only be changed by an admin in the DB.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_BUSINESS=

# Twilio phone voice bot. Auth token is used to verify Twilio's request signatures.
TWILIO_AUTH_TOKEN=
