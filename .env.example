# ---- Required ----
# The API must connect as the non-superuser "vanibot" role so row-level security keeps companies apart.
DATABASE_URL=postgres://vanibot:vanibot@localhost:5432/vanibot
# Long random string used to sign dashboard login tokens
JWT_SECRET=change-me-to-a-long-random-string
# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# 64 hex characters, used to encrypt WhatsApp access tokens. Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# ---- URLs ----
PORT=4000
# Public URL of the API (embed snippet, WhatsApp webhook, demo pages)
PUBLIC_URL=http://localhost:4000
# Dashboard URL (links from the website)
DASHBOARD_URL=http://localhost:5173

# ---- AI ----
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# Embeddings for semantic search. Without a key, search uses keyword (full-text) only.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# ---- WhatsApp (Meta WhatsApp Cloud API) ----
# From your Meta app (developers.facebook.com > your app > App settings > Basic > App secret).
WHATSAPP_APP_SECRET=
# Any string you choose; paste the same value into Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# Each company's phone number ID and access token are entered per bot in the dashboard.

# ---- Speech for WhatsApp voice notes and voice replies ----
# "sarvam" (Indian languages) or "none" (voice notes get a polite "please type" reply).
SPEECH_PROVIDER=sarvam
# From https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Leave empty for Sarvam's default speech-to-text model.
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=bulbul:v3
# Optional default voice, e.g. anushka. Can be changed per bot.
SARVAM_TTS_SPEAKER=

# ---- Phone calls (next phase; off by default) ----
PHONE_ENABLED=false
TWILIO_AUTH_TOKEN=
